###> Environnement de test ###
APP_NAME="LinkCoin API"
APP_ENV=test
APP_DEBUG=1
APP_SECRET=test_secret_key_12345678

###> Base de données test ###
POSTGRES_DB=app_test
POSTGRES_USER=app
POSTGRES_PASSWORD=password
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}"

###> JWT ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=test_passphrase_change_me

###> Mailer ###
MAILER_DSN=null://null
MAILER_FROM="test@example.com"
MAILER_TO=

###> Frontend ###
FRONTEND_BASE_URL=http://localhost:5173/
FRONTEND_LOGIN_URL=http://localhost:5173/auth/login/

###> Messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default

###> Redis ###
REDIS_URL=redis://127.0.0.1:6379

###> CORS ###
CORS_ALLOW_ORIGIN=http://localhost:5173
