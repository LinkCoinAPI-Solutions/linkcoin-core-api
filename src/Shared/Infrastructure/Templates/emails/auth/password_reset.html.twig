{% extends '@Shared/emails/base_email.html.twig' %}

{% block title %}Réinitialisation de votre mot de passe - {{ app_name }}{% endblock %}

{% block email_title %}
    🔐 Réinitialisation de mot de passe
{% endblock %}

{% block email_content %}
    <p class="email-greeting">Bonjour {{ first_name|default('Cher utilisateur') }},</p>
    
    <div class="email-message">
        <p>Vous avez demandé la réinitialisation du mot de passe de votre compte <strong>{{ app_name }}</strong>.</p>
        
        <p>Cliquez sur le bouton ci-dessous pour créer un nouveau mot de passe sécurisé :</p>
    </div>
    
    <div class="email-cta">
        <a href="{{ reset_link }}" 
           class="email-button" 
           role="button" 
           aria-label="Réinitialiser mon mot de passe"
           style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%) !important;">
            🔑 Réinitialiser le mot de passe
        </a>
    </div>
    
    <div class="email-message">
        <div style="background: #fef3c7; border: 1px solid #fbbf24; border-radius: 12px; padding: 20px; margin: 30px 0;">
            <p style="margin: 0; color: #92400e; font-weight: 600;">
                ⏰ <strong>Important :</strong> Ce lien expire dans <strong>{{ expiration_time|default('60') }} minutes</strong>.
            </p>
        </div>
        
        <p style="font-size: 15px; color: #64748b;">
            <strong>Lien de réinitialisation :</strong><br>
            <a href="{{ reset_link }}" style="word-break: break-all; color: #ef4444;">{{ reset_link }}</a>
        </p>
        
        <div style="background: #fee2e2; border: 1px solid #fca5a5; border-radius: 12px; padding: 20px; margin: 25px 0;">
            <p style="margin: 0; color: #dc2626; font-size: 14px;">
                <strong>🛡️ Sécurité :</strong> Si vous n'avez pas demandé cette réinitialisation, ignorez cet email. Votre compte reste sécurisé.
            </p>
        </div>
    </div>
{% endblock %}
