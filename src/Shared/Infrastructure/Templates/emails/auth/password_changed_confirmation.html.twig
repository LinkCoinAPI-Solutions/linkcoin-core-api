{% extends '@Shared/emails/base_email.html.twig' %}

{% block title %}Mot de passe mis à jour - {{ app_name }}{% endblock %}

{% block email_title %}
🔒 Mot de passe mis à jour !
{% endblock %}

{% block email_content %}
<p class="email-greeting">Parfait {{ first_name|e }} !</p>

<div class="email-message">
    <div style="background: #dcfce7; border: 1px solid #22c55e; border-radius: 16px; padding: 30px; margin: 30px 0;">
        <p style="margin: 0; color: #15803d; font-size: 18px; font-weight: 600;">
            🎉 <strong>Confirmation :</strong> Votre mot de passe a été mis à jour avec succès !
        </p>
    </div>

    <p>Votre compte <strong>{{ app_name }}</strong> est maintenant sécurisé avec votre nouveau mot de passe.</p>
</div>

<div class="email-cta">
    <a href="{{ login_url }}" class="email-button" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;">
        🚀 Se connecter maintenant
    </a>
</div>

<div class="email-message">
    <div style="background: #fef3c7; border: 1px solid #fbbf24; border-radius: 12px; padding: 20px; margin: 30px 0;">
        <p style="margin: 0; color: #92400e; font-weight: 600;">
            🛡️ <strong>Sécurité :</strong> Si ce changement n'a pas été effectué par vous, contactez immédiatement notre support.
        </p>
    </div>
</div>
{% endblock %}
