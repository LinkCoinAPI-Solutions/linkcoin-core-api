###> Configuration de base du projet (partagée avec l'équipe) ###
APP_NAME="LinkCoinAPI Solutions"
APP_SECRET=ChangeThisSecretKey
APP_ENV=dev
APP_DEBUG=true

# Variables MySQL pour Docker Compose
MYSQL_ROOT_PASSWORD=ChangeThisRootPassword
MYSQL_DATABASE=nexus
MYSQL_USER=symfony
MYSQL_PASSWORD=ChangeThisUserPassword

###> Base de données (Docker) ###
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}"

###> Services ###
REDIS_URL=redis://redis:6379

###> JWT (Clés à générer) ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ChangeThisPassphrase

###> Mailer ###
MAILER_DSN=null://null
MAILER_FROM="noreply@linkcoinapi.solutions"

###> Frontend ###
FRONTEND_BASE_URL=http://localhost:5173/
FRONTEND_LOGIN_URL=http://localhost:5173/auth/login/

###> CORS ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

###> Messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
